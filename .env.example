# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，请勿将真实密钥提交到 git

# ---------- LLM（火山方舟 / OpenAI 兼容接口） ----------
# 模型服务地址，如 https://ark.cn-beijing.volces.com/api/v3
BASE_URL=
# 模型服务 API Key
API_KEY=
# 模型名称（可选，默认 deepseek-v3-2-251201）
# LLM_MODEL=

# ---------- Embedding / Rerank（硅基流动） ----------
SF_BASE_URL=https://api.siliconflow.cn/v1
SF_API_KEY=

# ---------- 联网搜索（Tavily） ----------
TAVILY_API_KEY=

# ---------- 后端接口鉴权 ----------
# 所有业务接口需要在请求头携带 X-API-Key: <ADMIN_API_KEY>
# 请使用随机长字符串，例如: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ---------- 常用可选参数（留空即用默认值） ----------
# 文本切分：CHUNK_SIZE=500, CHUNK_OVERLAP=50, CHUNK_METHOD=fixed|sentence|paragraph
# 检索：TOP_K=10, SCORE_THRESHOLD=0.3, RERANK_TOP_N=3, USE_RERANK=True, USE_QUERY_REWRITE=True
# 超时（秒）：REQUEST_TIMEOUT=30, LLM_TIMEOUT=60
# Agent：MAX_TOKENS=2048, AGENT_RECURSION_LIMIT=15
# 多轮对话：会话数据库路径（默认 ./chat_history.db）、改写携带的最近消息条数
# CHAT_DB_PATH=./chat_history.db
# HISTORY_MAX_MESSAGES=6
